# Copy to .env and fill in. EXPO_PUBLIC_ vars are inlined into the client
# bundle at build time — safe here because these are the publishable
# (anon-equivalent) key, never the secret key. See claude.md "Backend".

# Local dev (supabase start): printed as "Project URL" / "Publishable" key.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
