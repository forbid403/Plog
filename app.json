{
  "expo": {
    "name": "Plog",
    "slug": "plog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sonia-bbb.plog",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.soniabbb.plog",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Plog uses your location to record your plogging route.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-task-manager",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Plog saves your Impact card to your photo library when you tap Download.",
          "granularPermissions": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Plog uses your photo library so you can add a profile photo or a photo of the litter you collected.",
          "cameraPermission": "Plog uses your camera so you can take a profile photo or a photo of the litter you collected.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "plog"
  }
}
